# Не заповнюйте вручну — краще одна команда, вона спитає паролі і запише .env:
#   uv run python -m tracker.passwd --write-env --dev   (локально)
#   python -m tracker.passwd --write-env                (на сервері, без --dev)
# .env у .gitignore і в репозиторій не потрапляє.
TRACKER_SECRET_KEY=
TRACKER_USERS=marko:scrypt:...;olya:scrypt:...
# TRACKER_DEV=1   # лише локально, дозволяє http
